{$TCHIHALI_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 7MB
	}
	reverse_proxy api:8080
}

# Sites supplémentaires (ex. version web, voir docker-compose.web.yml). Aucun fichier = rien à charger.
import /etc/caddy/sites/*.caddy
