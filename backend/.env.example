# Copier en .env puis adapter. En production : TCHIHALI_ENV=production et secrets forts.
TCHIHALI_ENV=dev
TCHIHALI_DATABASE_URL=postgresql://tchihali:tchihali@127.0.0.1:55432/tchihali
# openssl rand -hex 32
TCHIHALI_JWT_SECRET=dev-only-change-me
TCHIHALI_OTP_SECRET=dev-only-change-me-too
# dev : le code SMS est écrit dans les journaux. production : brancher un vrai fournisseur (voir app/sms.py).
TCHIHALI_SMS_PROVIDER=console
# dev seulement : renvoie le code dans la réponse pour tester sans SMS
TCHIHALI_DEV_RETURN_CODE=true
# dev seulement : code SMS toujours identique (6 chiffres). Laisser vide en production.
TCHIHALI_DEV_FIXED_CODE=123456
# simulated : le paiement est simulé (aucun argent ne bouge). À remplacer par MTN MoMo / Orange Money.
TCHIHALI_PAYMENT_PROVIDER=simulated
TCHIHALI_CORS_ORIGINS=
# Dossier des fichiers envoyés (photos, documents). À chiffrer et sauvegarder en production.
TCHIHALI_FILES_DIR=./data/files
TCHIHALI_MAX_UPLOAD_MB=5
